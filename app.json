{
  "expo": {
    "name": "MealPrep",
    "slug": "mealprep-mobile",
    "scheme": "mealprep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "studio.blackboard.mealprep"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFFFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "studio.blackboard.mealprep"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Promo-Regular.ttf",
            "./assets/fonts/Promo-Medium.ttf",
            "./assets/fonts/Promo-SemiBold.ttf",
            "./assets/fonts/Promo-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-splash-screen"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    }
  }
}
