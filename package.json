{
  "name": "mealprep-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "bun@1.4.2",
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.6",
    "openai": "7.10.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.12.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "1.4.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "57.0.10",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^57.0.2",
    "prettier-plugin-tailwindcss": "0.5.14",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "bun --watch server/index.ts",
    "server:start": "bun server/index.ts",
    "catalog:build": "bun scripts/build-catalog.ts",
    "lint": "eslint .",
    "commitlint:check": "commitlint",
    "secrets:check": "bun scripts/check-secrets.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun run secrets:check && bun run lint && bun run typecheck && bun test && bunx expo-doctor"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
